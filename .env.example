# Paula — environment. Copy to `.env` (git-ignored) and fill in.
# Everything is optional: with nothing set, the app runs fully on localStorage and rules.

# PLUG(supabase): 'local' (default) or 'supabase'. Lovable Cloud fills the keys below.
VITE_BACKEND=local
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PLUG(ai): base URL of the edge functions (/stylist, /enrich). Empty = keyword rules.
VITE_AI_ENDPOINT=

# Adres edge function `fetch-product` (czytanie linku ze sklepu).
# OPCJONALNE. Pusty = adres wylicza sie z VITE_SUPABASE_URL. Ustawiaj tylko,
# gdy funkcja stoi gdzie indziej niz projekt Supabase aplikacji.
VITE_FETCH_PRODUCT_ENDPOINT=

# PLUG(photo): klucz do fal.ai dla pomiaru ze zdjęcia (SAM 3D Body).
# BEZ przedrostka VITE_ — i to jest cała różnica: przedrostek wstawiłby klucz do
# paczki, którą pobiera przeglądarka. Pusty = ekran „zmierz ze zdjęcia" mówi
# wprost, że nie ma czym liczyć, zamiast udawać, że działa.
FAL_KEY=

# Ścieżka do Pythona z warsztatu body-lab. Puste = ../body-lab/.venv/bin/python
PAULA_BODYLAB_PYTHON=
